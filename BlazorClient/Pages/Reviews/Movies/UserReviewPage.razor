@page "/user-reviews/movies/{ReviewId:long}"
@inherits CancellableComponentBase
@using BlazorClient.Components.PagesComponents.Common
@using Domain.Common.News

<MovieMenu Year="@((MovieViewerReview?.Movie?.PremierDate ?? DateOnly.FromDateTime(DateTime.Now)).Year)" />

@if (MovieViewerReview is null || News is null)
{
    <LoadingIndicator />
}
else
{
    <div id="content" class="lcol">
        <div class="content-title">
            <h3><a href="/movies/details/@MovieViewerReview.MovieId">@MovieViewerReview.Movie.Name</a></h3>
        </div>
        <div class="post-reviews">
            <div class="reviews-text mark-@MovieViewerReview.Score.ToString("0")">
                <div class="comment-meta">
                    <div class="rating-com">
                        <span class="ldc-ul_like" onclick="alter_ul_post_values(this,'18067','c_like')">+ <span>1</span></span><span class="ldc-ul_dislike" onclick="alter_ul_post_values(this,'18067','c_dislike')">- <span>0</span></span>
                    </div>
                    <div class="small-score mark-@MovieViewerReview.Score.ToString("0")">
                        <span>@MovieViewerReview.Score.ToString("0")</span>
                        <meta content="0">
                        <meta content="10">
                    </div>
                    <div class="title-reviews">
                        @MovieViewerReview.ApplicationUser.UserName
                    </div>
                    @MovieViewerReview.Date.ToString("dd.MM.yyyy")
                </div>
                <p>
                    @MovieViewerReview.TextContent
                </p>
            </div>
        </div>
        <div class="news-module">
            @foreach (NewsItem newsItem in News)
            {
                <div class="news-item">
                    <a href="/news/@newsItem.Id" title="@newsItem.Title">
                        <img class="news-thumb" src="@newsItem.ImageSource" alt="@newsItem.Title">
                        <span class="news-title">
                            @TextTruncater.Truncate(newsItem.TextContent, 150)
                        </span>
                    </a>
                </div>
            }
        </div>
    </div>
}