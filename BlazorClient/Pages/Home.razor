@page "/"
@using BlazorClient.Components.PagesComponents.Common
@using BlazorClient.Components.PagesComponents.Home
@using BlazorClient.Pages.Games.Games
@using BlazorClient.Pages.Movies.Movies

<BlazorClient.Components.PagesComponents.Common.GameMenu Year="@DateTime.Today.Year" />

<AuthorizeView Policy="Admin">
    <Authorized>
        <a href="/admin">Страница администратора</a>
    </Authorized>
</AuthorizeView>

<AuthorizeView>
    <Authorized>
        <a href="/auth/account">Аккаунт</a>
    </Authorized>
</AuthorizeView>

@if (Games is null || GamesReviews is null || Movies is null || MoviesReviews is null)
{
    <p>Loading...</p>
}
else
{
    @if (SlideGroups.Any())
    {
        <Slideshow Groups="@SlideGroups" Interval="7000" />
    }
    <div id="container" class="clear">
        <div class="sidebar">
        </div>
        <div id="content" class="lcol">
            <div id="loop" class="list clear">
                <div class="index-movies">
                    <h3><a href="/movies/new-movies/">Новые фильмы</a></h3>
                    <MoviesListComponent Movies="@Movies" />
                    <div class="title-index">
                        <div class="dropdown-menu genre" @onclick="ToggleDropdownMovies">
                            <span class="title">Год</span>
                            @if (isMoviesDropdownOpen)
                            {
                                <ul>
                                    @for (int year = DateTime.Now.Year; year >= DateTime.Now.Year - 8; year--)
                                    {
                                        <li><a href="/movies/best-movies/?year=@year">Фильмы @year</a></li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                    <a class="allreviews" href="/meta/movies/">Обзоры на фильмы</a>
                </div>

                <div class="index-games">
                    <h3><a href="/games/new-games/">Новые игры</a></h3>
                    <GamesListComponent Games="@Games" />
                    <div class="title-index">
                        <div class="dropdown-menu genre" @onclick="ToggleDropdownGames">
                            <span class="title">Год</span>
                            @if (isGamesDropdownOpen)
                            {
                                <ul>
                                    @for (int year = DateTime.Now.Year; year >= DateTime.Now.Year - 8; year--)
                                    {
                                        <li><a href="/games/best-games/?year=@year">Игры @year</a></li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                    <a class="allreviews" href="/meta/games/">Обзоры на игры</a>
                </div>
                <div class="ads-horizont hor-1">
                    <!-- Yandex.RTB R-A-201169-5 -->
                    <div id="yandex_rtb_R-A-201169-5"></div>
                    <script>
                                        window.yaContextCb.push(() => {
                                            Ya.Context.AdvManager.render({
                                                renderTo: "yandex_rtb_R-A-201169-5",
                                                blockId: "R-A-201169-5"
                                            })
                        })</script>
                    </div>

                    @if (CollectionsItemComponents is not null)
                    {
                        <CollectionsComponent CollectionsItemComponents="CollectionsItemComponents" />
                    }
                    @if (SoonAtCinemasItemComponents is not null)
                    {
                        <SoonAtCinemasComponent SoonAtCinemasItemComponents="SoonAtCinemasItemComponents" />
                    }
                    @if (GamesReleaseDateItemComponents is not null)
                    {
                        <GamesReleaseDateComponent GamesReleaseDateItemComponents="GamesReleaseDateItemComponents" />
                    }
                </div>
            </div>
        </div>
    }