@page "/"
@using BlazorClient.Components.PagesComponents.Home
@using BlazorClient.Pages.Games.Games
@using BlazorClient.Pages.Movies.Movies
@using Domain.Games
@using Domain.Movies
@using WMBlazorSlickCarousel.WMBSC

<BlazorClient.Components.PagesComponents.Common.GameMenu Year="@DateTime.Today.Year" />

<AuthorizeView Policy="Admin">
    <Authorized>
        <a href="/admin">Страница администратора</a>
    </Authorized>
</AuthorizeView>

<AuthorizeView>
    <Authorized>
        <a href="/two-factor-enabled">Установить вход по 2FA?</a>
    </Authorized>
</AuthorizeView>

<div class="pager">Лучшие в прошлом месяце <span class="">Фильмы</span><span class="cycle-pager-active">Игры</span></div>

@if (Games is null || GamesReviews is null || Movies is null || MoviesReviews is null)
{
    <p>Loading...</p>
}
else
{
    <BlazorSlickCarousel @ref="theCarousel" Configurations="configurations">
        <BlazorSlickCarouselContent>
            @foreach (Game game in Games)
            {
                <img src="@game.Image" alt="@game.Name">
            }
            @foreach (Movie movie in Movies)
            {
                <img src="@movie.ImageSource" alt="@movie.Name">
            }
        </BlazorSlickCarouselContent>
        <BlazorSlickCarouselLoading>
            <p>Loading...</p>
        </BlazorSlickCarouselLoading>
    </BlazorSlickCarousel>
    <div id="container" class="clear">
        <div class="sidebar">
        </div>
        <div id="content" class="lcol">
            <div id="loop" class="list clear">
                <div class="index-movies">
                    <h3><a href="/movies/new-movies/">Новые фильмы</a></h3>
                    <MoviesListComponent Movies="@Movies" />
                    <div class="title-index">
                        <div class="dropdown-menu genre">
                            <span class="title">Год</span>
                            <ul>
                                <li><a href="/movies/best-movies/?year=2025">Фильмы 2025</a></li>
                                <li><a href="/movies/best-movies/?year=2024">Фильмы 2024</a></li>
                                <li><a href="/movies/best-movies/?year=2023">Фильмы 2023</a></li>
                                <li><a href="/movies/best-movies/?year=2022">Фильмы 2022</a></li>
                                <li><a href="/movies/best-movies/?year=2021">Фильмы 2021</a></li>
                                <li><a href="/movies/best-movies/?year=2020">Фильмы 2020</a></li>
                                <li><a href="/movies/best-movies/?year=2019">Фильмы 2019</a></li>
                                <li><a href="/movies/best-movies/?year=2018">Фильмы 2018</a></li>
                            </ul>
                        </div>
                    </div>
                    <a class="allreviews" href="/meta/movies/">Обзоры на фильмы</a>
                </div>

                <div class="index-games">
                    <h3><a href="/games/new-games/">Новые игры</a></h3>
                    <GamesListComponent Games="@Games" />
                    <div class="title-index">
                        <div class="dropdown-menu genre">
                            <span class="title">Год</span>
                            <ul>
                                <li><a href="/games/best-games/?year=2025">Игры 2025</a></li>
                                <li><a href="/games/best-games/?year=2024">Игры 2024</a></li>
                                <li><a href="/games/best-games/?year=2023">Игры 2023</a></li>
                                <li><a href="/games/best-games/?year=2022">Игры 2022</a></li>
                                <li><a href="/games/best-games/?year=2021">Игры 2021</a></li>
                                <li><a href="/games/best-games/?year=2020">Игры 2020</a></li>
                                <li><a href="/games/best-games/?year=2019">Игры 2019</a></li>
                                <li><a href="/games/best-games/?year=2018">Игры 2018</a></li>
                            </ul>
                        </div>
                    </div>
                    <a class="allreviews" href="/meta/games/">Обзоры на игры</a>
                </div>
                <div class="ads-horizont hor-1">
                    <!-- Yandex.RTB R-A-201169-5 -->
                    <div id="yandex_rtb_R-A-201169-5"></div>
                    <script>
                                        window.yaContextCb.push(() => {
                                            Ya.Context.AdvManager.render({
                                                renderTo: "yandex_rtb_R-A-201169-5",
                                                blockId: "R-A-201169-5"
                                            })
                        })</script>
                    </div>

                    @if (CollectionsItemComponents is not null)
                    {
                        <CollectionsComponent CollectionsItemComponents="CollectionsItemComponents" />
                    }
                    @if (SoonAtCinemasItemComponents is not null)
                    {
                        <SoonAtCinemasComponent SoonAtCinemasItemComponents="SoonAtCinemasItemComponents" />
                    }
                    @if (GamesReleaseDateItemComponents is not null)
                    {
                        <GamesReleaseDateComponent GamesReleaseDateItemComponents="GamesReleaseDateItemComponents" />
                    }
                </div>
            </div>
        </div>
    }
