@page "/admin/movies/remove-movie/{Id:long}"
@using Domain.Movies
@using Domain.RequestsModels.Games
@using Domain.RequestsModels.Movies.Movies
@inherits RemoveEntityPageBase<Movie, AddMovieModel, UpdateMovieModel>


<AuthorizeView Policy="Admin">
    <Authorized>
        <a href="/admin">К странице админа</a>
        @if (Entity is null)
        {
            <p>Загружается...</p>
        }
        else
        {
            <a href="/admin/movies/list-movies" class="list-group-item link-dark">Фильмы</a>

            <h3>Удалить @Entity.Name</h3>
            <p>Вы уверены, что хотите удалить этот фильм?</p>
            <p>
                <button type="button" @onclick="RemoveAsync">Удалить</button>
            </p>
        }
    </Authorized>
    <NotAuthorized>
        <a href="/auth/login">Авторизируйся</a> или <a href="/auth/register">Зарегистрируйся</a> админом, чтобы удалить фильм
    </NotAuthorized>
</AuthorizeView>
