@page "/admin/movies/edit-movie/{Id:long}"
@using BlazorClient.Components.PagesComponents.Common
@using Domain.Movies

<AuthorizeView Policy="Admin">
    <Authorized>
        <a href="/admin/movies/list-movies" class="list-group-item link-dark">Фильмы</a>
        <a href="/admin">К странице админа</a>

        @if (IsNotFound)
        {
            <p>Фильм не найден.</p>
        }
        else if (Movie is null || MoviesDirectorsToSelectFrom is null || MoviesGenresToSelectFrom is null || MoviesStudiosToSelectFrom is null)
        {
            <p>Загружается...</p>
        }
        else
        {
            <h3>Редактировать фильм: @Movie.Name</h3>

            <EditForm OnValidSubmit="UpdateMovieAsync" Model="this" Context="editContext">
                <p>
                    <label>
                        Название:
                        <InputText @bind-Value="@Name" />
                    </label>
                </p>
                <p>
                    <label>
                        Оригинальное название:
                        <InputText @bind-Value="@OriginalName" />
                    </label>
                </p>
                <p>
                    <label>
                        Дата премьеры:
                        <InputDate @bind-Value="@PremierDate" />
                    </label>
                </p>
                <p>
                    <label>
                        Описание:
                        <InputTextArea @bind-Value="@Description" rows="6" cols="80" />
                    </label>
                </p>

                <TrailerField @bind-Value="Trailer" />

                <p>
                    <label>Режиссёры:</label>
                    @{
                        var directorSelector = (MovieDirector d) => d.Id;
                        var directorDisplay = (MovieDirector d) => d.Name;
                    }
                    <MultiSelect TItem="MovieDirector"
                                 TId="long"
                                 Items="MoviesDirectorsToSelectFrom.ToList()"
                                 @bind-SelectedIds="SelectedMoviesDirectorsIds"
                                 IdSelector="directorSelector"
                                 DisplaySelector="directorDisplay"
                                 Placeholder="Select directors..."
                                 LabelPlural="directors" />
                </p>
                <p>
                    <label>Жанры:</label>
                    @{
                        var movieGenreSelector = (Genre mg) => mg.Id;
                        var movieGenreDisplay = (Genre mg) => mg.Name;
                    }
                    <MultiSelect TItem="Genre"
                                 TId="long"
                                 Items="MoviesGenresToSelectFrom.ToList()"
                                 @bind-SelectedIds="SelectedMoviesGenresIds"
                                 IdSelector="movieGenreSelector"
                                 DisplaySelector="movieGenreDisplay"
                                 Placeholder="Select genres..."
                                 LabelPlural="genres" />
                </p>
                <p>
                    <label>Студии:</label>
                    @{
                        var movieStudioSelector = (MovieStudio ms) => ms.Id;
                        var movieStudioDisplay = (MovieStudio ms) => ms.Name;
                    }
                    <MultiSelect TItem="MovieStudio"
                                 TId="long"
                                 Items="MoviesStudiosToSelectFrom.ToList()"
                                 @bind-SelectedIds="SelectedMoviesStudiosIds"
                                 IdSelector="movieStudioSelector"
                                 DisplaySelector="movieStudioDisplay"
                                 Placeholder="Select studios..."
                                 LabelPlural="studios" />
                </p>
                <p>
                    <label>
                        Постер (оставьте пустым, чтобы не менять):
                        <InputFile OnChange="FileUploaded" accept="image/*" />
                    </label>
                    <div class="image-container">
                        <img class="post-image" src="@ImagePreview" alt="Постер фильма @Name" title="Фильм @Name">
                    </div>
                </p>

                <p>
                    <button type="submit" disabled="@IsSaving">@(IsSaving ? "Сохранение..." : "Сохранить")</button>
                    <a href="/movies/details/@Id">К странице фильма</a>
                </p>
            </EditForm>
        }
    </Authorized>
    <NotAuthorized>
        <a href="/auth/login">Авторизируйся</a> или <a href="/auth/register">Зарегистрируйся</a> админом, чтобы редактировать фильм
    </NotAuthorized>
</AuthorizeView>
