@page "/admin/movies/edit-movie/{Id:long}"
@using BlazorClient.Components.PagesComponents.Common
@using BlazorClient.Components.PagesComponents.MovieDetails
@using Domain.Movies

<AuthorizeView Policy="Admin">
    <Authorized>
        <a href="/admin/movies/list-movies" class="list-group-item link-dark">Фильмы</a>
        <a href="/admin">К странице админа</a>

        @if (IsNotFound)
        {
            <p>Фильм не найден.</p>
        }
        else if (Movie is null || MoviesDirectorsToSelectFrom is null || MoviesGenresToSelectFrom is null || MoviesStudiosToSelectFrom is null || MoviesCountriesToSelectFrom is null)
        {
            <p>Загружается...</p>
        }
        else
        {
            <h3>Редактировать фильм: @Movie.Name</h3>

            <EditForm OnValidSubmit="UpdateMovieAsync" Model="this" Context="editContext">
                <p>
                    <label>
                        Название:
                        <InputText @bind-Value="@Name" />
                    </label>
                </p>
                <p>
                    <label>
                        Оригинальное название:
                        <InputText @bind-Value="@OriginalName" />
                    </label>
                </p>
                <p>
                    <label>
                        Дата премьеры:
                        <InputDate @bind-Value="@PremierDate" />
                    </label>
                </p>
                <p>
                    <label>
                        Описание:
                        <InputTextArea @bind-Value="@Description" rows="6" cols="80" />
                    </label>
                </p>

                <TrailerField @bind-Value="Trailer" />

                <p>
                    <label>Режиссёры:</label>
                    <OrderedMultiSelect TItem="MovieDirector"
                                        TId="long"
                                        Items="SelectedMoviesDirectors"
                                        AllItems="MoviesDirectorsToSelectFrom.ToList()"
                                        IdSelector="@(d => d.Id)"
                                        DisplaySelector="@(d => d.Name)"
                                        Placeholder="Select directors..."
                                        LabelPlural="режиссёры"
                                        ItemsChanged="OnSelectedDirectorsChanged" />
                </p>
                <p>
                    <label>Жанры:</label>
                    <OrderedMultiSelect TItem="Genre"
                                        TId="long"
                                        Items="SelectedMoviesGenres"
                                        AllItems="MoviesGenresToSelectFrom.ToList()"
                                        IdSelector="@(g => g.Id)"
                                        DisplaySelector="@(g => g.Name)"
                                        Placeholder="Select genres..."
                                        LabelPlural="жанры"
                                        ItemsChanged="OnSelectedGenresChanged" />
                </p>
                <p>
                    <label>Студии:</label>
                    <OrderedMultiSelect TItem="MovieStudio"
                                        TId="long"
                                        Items="SelectedMoviesStudios"
                                        AllItems="MoviesStudiosToSelectFrom.ToList()"
                                        IdSelector="@(s => s.Id)"
                                        DisplaySelector="@(s => s.Name)"
                                        Placeholder="Select studios..."
                                        LabelPlural="студии"
                                        ItemsChanged="OnSelectedStudiosChanged" />
                </p>
                <p>
                    <label>Страны:</label>
                    <OrderedMultiSelect TItem="MovieCountry"
                                        TId="long"
                                        Items="SelectedMoviesCountries"
                                        AllItems="MoviesCountriesToSelectFrom.ToList()"
                                        IdSelector="@(c => c.Id)"
                                        DisplaySelector="@(c => c.Name)"
                                        Placeholder="Select countries..."
                                        LabelPlural="страны"
                                        ItemsChanged="OnSelectedCountriesChanged" />
                    <a href="/admin/movies/movies-countries/add-movie-country" target="_blank">Добавить страну</a>
                </p>

                <DragDropCrewEditor Texts="CrewTexts" />

                <p>
                    <label>
                        Постер (оставьте пустым, чтобы не менять):
                        <InputFile OnChange="FileUploaded" accept="image/*" />
                    </label>
                    <div class="image-container">
                        <img class="post-image" src="@ImagePreview" alt="Постер фильма @Name" title="Фильм @Name">
                    </div>
                </p>

                <p>
                    <button type="submit" disabled="@IsSaving">@(IsSaving ? "Сохранение..." : "Сохранить")</button>
                    <a href="/movies/details/@Id">К странице фильма</a>
                </p>
            </EditForm>
        }
    </Authorized>
    <NotAuthorized>
        <a href="/auth/login">Авторизируйся</a> или <a href="/auth/register">Зарегистрируйся</a> админом, чтобы редактировать фильм
    </NotAuthorized>
</AuthorizeView>