@page "/admin/movies/add-movie"
@using BlazorClient.Components.PagesComponents.Common
@using Domain.Movies

<h3>Add movie page</h3>

<a href="/admin/movies/list-movies" class="list-group-item link-dark">Фильмы</a>

<AuthorizeView Roles="Admin">
    <Authorized>
        <a href="/admin">К странице админа</a>
        @if (MoviesDirectorsToSelectFrom is null || MoviesGenresToSelectFrom is null || MoviesStudiosToSelectFrom is null)
        {
            <p>Загружается...</p>
        }
        else
        {
            <EditForm OnValidSubmit="AddMovieAsync" Model="this" Context="myContext">
                <p>
                    <label>
                        Enter original name:
                        <InputText @bind-Value="@OriginalName" />
                        <ValidationMessage For="() => OriginalName" />
                    </label>
                </p>
                <p>
                    <label>
                        Enter name:
                        <InputText @bind-Value="@Name" />
                        <ValidationMessage For="() => OriginalName" />
                    </label>
                </p>
                <p>
                    <label>
                        Enter premier date:
                        <InputDate @bind-Value="@PremierDate" />
                        <ValidationMessage For="() => PremierDate" />
                    </label>
                </p>
                <p>
                    <label>
                        Enter description:
                        <InputTextArea @bind-Value="@Description" />
                        <ValidationMessage For="() => Description" />
                    </label>
                </p>
                <p>
                    <label>Select movie director:</label>
                    @{
                        var directorSelector = (MovieDirector d) => d.Id;
                        var directorDisplay = (MovieDirector d) => d.Name;
                    }
                    <MultiSelect TItem="MovieDirector"
                                 TId="long"
                                 Items="MoviesDirectorsToSelectFrom.ToList()"
                                 @bind-SelectedIds="SelectedMoviesDirectorsIds"
                                 IdSelector="directorSelector"
                                 DisplaySelector="directorDisplay"
                                 Placeholder="Select directors..."
                                 LabelPlural="director" />
                </p>
                <p>
                    <label>Select movie genre:</label>
                    @{
                        var movieGenreSelector = (Genre mg) => mg.Id;
                        var movieGenreDisplay = (Genre mg) => mg.Name;
                    }
                    <MultiSelect TItem="Genre"
                                 TId="long"
                                 Items="MoviesGenresToSelectFrom.ToList()"
                                 @bind-SelectedIds="SelectedMoviesGenresIds"
                                 IdSelector="movieGenreSelector"
                                 DisplaySelector="movieGenreDisplay"
                                 Placeholder="Select genres..." />
                    <ValidationMessage For="() => SelectedMoviesGenres" />
                </p>
                <p>
                    <label>Select movie studio:</label>
                    @{
                        var movieStudioSelector = (MovieStudio ms) => ms.Id;
                        var movieStudioDisplay = (MovieStudio ms) => ms.Name;
                    }
                    <MultiSelect TItem="MovieStudio"
                                 TId="long"
                                 Items="MoviesStudiosToSelectFrom.ToList()"
                                 @bind-SelectedIds="SelectedMoviesStudiosIds"
                                 IdSelector="movieStudioSelector"
                                 DisplaySelector="movieStudioDisplay"
                                 Placeholder="Select studios..." />
                    <ValidationMessage For="() => SelectedMoviesStudios" />
                </p>
                <p>
                    <label>
                        Enter image:
                        <InputFile OnChange="FileUploaded" />
                        <ValidationMessage For="() => ImageToUpload" />
                    </label>
                    <div class="image-container">
                        <img class="post-image" src="@ImageSource" alt="Изображение на странице игры для загрузки фильма" title="Фильм @Name" itemprop="image">
                    </div>
                </p>
                <input type="submit" value="Submit" />
            </EditForm>
        }
    </Authorized>
    <NotAuthorized>
        <a href="/auth/login">Авторизируйся</a> или <a href="/auth/register">Зарегистрируйся</a> админом, чтобы добавить фильм
    </NotAuthorized>
</AuthorizeView>