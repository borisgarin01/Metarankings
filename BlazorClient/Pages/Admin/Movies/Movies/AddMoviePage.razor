@page "/admin/movies/add-movie"
@using BlazorClient.Components.PagesComponents.Common
@using BlazorClient.Components.PagesComponents.MovieDetails
@using Domain.Movies

<h3>Add movie page</h3>

<a href="/admin/movies/list-movies" class="list-group-item link-dark">Фильмы</a>

<AuthorizeView Roles="Admin">
    <Authorized>
        <a href="/admin">К странице админа</a>
        @if (MoviesDirectorsToSelectFrom is null || MoviesGenresToSelectFrom is null || MoviesStudiosToSelectFrom is null || MoviesCountriesToSelectFrom is null)
        {
            <p>Загружается...</p>
        }
        else
        {
            <EditForm OnValidSubmit="AddMovieAsync" Model="this" Context="myContext">
                <p>
                    <label>
                        Enter original name:
                        <InputText @bind-Value="@OriginalName" />
                        <ValidationMessage For="() => OriginalName" />
                    </label>
                </p>
                <p>
                    <label>
                        Enter name:
                        <InputText @bind-Value="@Name" />
                        <ValidationMessage For="() => Name" />
                    </label>
                </p>
                <p>
                    <label>
                        Enter premier date:
                        <InputDate @bind-Value="@PremierDate" />
                        <ValidationMessage For="() => PremierDate" />
                    </label>
                </p>
                <p>
                    <label>
                        Enter description:
                        <InputTextArea @bind-Value="@Description" />
                        <ValidationMessage For="() => Description" />
                    </label>
                </p>

                <TrailerField @bind-Value="Trailer" />

                <p>
                    <label>Select movie director:</label>
                    <OrderedMultiSelect TItem="MovieDirector"
                                        TId="long"
                                        Items="SelectedMoviesDirectors"
                                        AllItems="MoviesDirectorsToSelectFrom.ToList()"
                                        IdSelector="@(d => d.Id)"
                                        DisplaySelector="@(d => d.Name)"
                                        Placeholder="Select directors..."
                                        LabelPlural="режиссёры"
                                        ItemsChanged="OnSelectedDirectorsChanged" />
                </p>
                <p>
                    <label>Select movie genre:</label>
                    <OrderedMultiSelect TItem="Genre"
                                        TId="long"
                                        Items="SelectedMoviesGenres"
                                        AllItems="MoviesGenresToSelectFrom.ToList()"
                                        IdSelector="@(g => g.Id)"
                                        DisplaySelector="@(g => g.Name)"
                                        Placeholder="Select genres..."
                                        LabelPlural="жанры"
                                        ItemsChanged="OnSelectedGenresChanged" />
                </p>
                <p>
                    <label>Select movie studio:</label>
                    <OrderedMultiSelect TItem="MovieStudio"
                                        TId="long"
                                        Items="SelectedMoviesStudios"
                                        AllItems="MoviesStudiosToSelectFrom.ToList()"
                                        IdSelector="@(s => s.Id)"
                                        DisplaySelector="@(s => s.Name)"
                                        Placeholder="Select studios..."
                                        LabelPlural="студии"
                                        ItemsChanged="OnSelectedStudiosChanged" />
                </p>
                <p>
                    <label>Страны:</label>
                    <OrderedMultiSelect TItem="MovieCountry"
                                        TId="long"
                                        Items="SelectedMoviesCountries"
                                        AllItems="MoviesCountriesToSelectFrom.ToList()"
                                        IdSelector="@(c => c.Id)"
                                        DisplaySelector="@(c => c.Name)"
                                        Placeholder="Select countries..."
                                        LabelPlural="страны"
                                        ItemsChanged="OnSelectedCountriesChanged" />
                    <a href="/admin/movies/movies-countries/add-movie-country" target="_blank">Добавить страну</a>
                </p>

                <DragDropCrewEditor Texts="CrewTexts" />

                <p>
                    <label>
                        Enter image:
                        <InputFile OnChange="FileUploaded" />
                        <ValidationMessage For="() => ImageToUpload" />
                    </label>
                    <div class="image-container">
                        <img class="post-image" src="@ImageSource" alt="Изображение на странице игры для загрузки фильма" title="Фильм @Name" itemprop="image">
                    </div>
                </p>
                <input type="submit" value="Submit" />
            </EditForm>
        }
    </Authorized>
    <NotAuthorized>
        <a href="/auth/login">Авторизируйся</a> или <a href="/auth/register">Зарегистрируйся</a> админом, чтобы добавить фильм
    </NotAuthorized>
</AuthorizeView>