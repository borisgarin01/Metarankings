@page "/admin/movies/movies-persons/remove-movie-person/{Id:long}"
@using Domain.Movies
@using Domain.RequestsModels.Movies.MoviesPersons
@inherits RemoveEntityPageBase<MoviePerson, AddMoviePersonModel, UpdateMoviePersonModel>

<AuthorizeView Policy="Admin">
    <Authorized>
        <a href="/admin">К странице админа</a>
        @if (Entity is null)
        {
            <p>Загружается...</p>
        }
        else
        {
            <h3>Удалить @Entity.Name</h3>
            <p>Вы уверены, что хотите удалить эту персону? Связи с фильмами тоже будут удалены.</p>
            <p>
                <button type="button" @onclick="RemoveAsync">Удалить</button>
            </p>
        }
    </Authorized>
    <NotAuthorized>
        <a href="/auth/login">Авторизируйся</a> или <a href="/auth/register">Зарегистрируйся</a> админом, чтобы удалить запись
    </NotAuthorized>
</AuthorizeView>
