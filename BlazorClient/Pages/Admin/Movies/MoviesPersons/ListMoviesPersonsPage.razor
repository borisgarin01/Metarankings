@page "/admin/movies/movies-persons/movies-persons-list"
@inherits CancellableComponentBase
@using Domain.Movies

<AuthorizeView Policy="Admin">
    <Authorized>
        <a href="/admin">К странице админа</a>
        <a href="/admin/movies/movies-persons/add-movie-person">Добавить</a>
        <p>
            <input type="search" placeholder="Поиск..." @bind="Filter" @bind:event="oninput" />
        </p>
        @if (Entities is null)
        {
            <p>Загружается...</p>
        }
        else
        {
            foreach (MoviePerson entity in FilteredEntities)
            {
                <div class="movie-person">
                    <h4><a href="/movies/best-movies?MoviePersonId=@entity.Id">@entity.Name</a></h4>
                    <a href="/admin/movies/movies-persons/remove-movie-person/@entity.Id">Удалить</a>
                </div>
            }
        }
    </Authorized>
    <NotAuthorized>
        <a href="/auth/login">Авторизируйся</a> или <a href="/auth/register">Зарегистрируйся</a> админом, чтобы управлять справочником
    </NotAuthorized>
</AuthorizeView>
