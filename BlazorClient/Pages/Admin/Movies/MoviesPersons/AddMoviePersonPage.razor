@page "/admin/movies/movies-persons/add-movie-person"
@inherits CancellableComponentBase

<AuthorizeView Policy="Admin">
    <Authorized>
        <a href="/admin">К странице админа</a>
        <a href="/admin/movies/movies-persons/movies-persons-list">Съёмочная группа</a>
        <EditForm Model="this" OnValidSubmit="@AddAsync" Context="formContext">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <InputText @bind-Value="@Name" placeholder="Название" />
            <ValidationMessage For="() => Name" />
            <button type="submit">Добавить</button>
        </EditForm>
    </Authorized>
    <NotAuthorized>
        <a href="/auth/login">Авторизируйся</a> или <a href="/auth/register">Зарегистрируйся</a> админом, чтобы добавить персону
    </NotAuthorized>
</AuthorizeView>
