@page "/admin/movies/movies-studios/add-movie-studio"
@inherits CancellableComponentBase

<a href="/admin">К странице админа</a>

<EditForm Model="this" OnValidSubmit="@AddMovieStudioAsync" Context="myContext">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <InputText @bind-Value="@Name" />
    <ValidationMessage For="() => Name" />
    <button type="submit">Add</button>
</EditForm>
