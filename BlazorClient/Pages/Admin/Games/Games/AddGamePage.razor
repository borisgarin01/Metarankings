@page "/admin/games/games/add-game"
@using Domain.Games

<h3>Add game page</h3>

<a href="/admin/games/games/list-games" class="list-group-item link-dark">Игры</a>

<a href="/admin">К странице админа</a>

<EditForm OnValidSubmit="AddGameAsync" Model="this" Context="myContext">

    <DataAnnotationsValidator />
    <ValidationSummary />

    @if (DevelopersToSelectFrom is null || GenresToSelectFrom is null || LocalizationsToSelectFrom is null || PlatformsToSelectFrom is null || PublishersToSelectFrom is null)
    {
        <p>Загружается...</p>
    }
    else
    {
        <p>
            <label>
                Enter name:
                <InputText @bind-Value="@Name" />
                <ValidationMessage For="() => Name" />
            </label>
        </p>
        <p>
            <label>
                Enter release date:
                <InputDate @bind-Value="@ReleaseDate" />
                <ValidationMessage For="() => ReleaseDate" />
            </label>
        </p>
        <p>
            <label>
                Enter description:
                <InputTextArea @bind-Value="@Description" />
                <ValidationMessage For="() => Description" />
            </label>
        </p>
        <p>
            <label>
                Enter trailer:
                <InputText @bind-Value="@Trailer" />
                <ValidationMessage For="() => Trailer" />
            </label>
        </p>

        <p>
            <label>
                Select developers:
                <InputSelect @bind-Value="SelectedDevelopersIds" multiple>
                    <option value="-1" selected>None</option>
                    @foreach (Developer developer in DevelopersToSelectFrom)
                    {
                        <option value="@developer.Id.ToString()">@developer.Name</option>
                    }
                </InputSelect>
            </label>
        </p>
        <p>
            <label>
                Select genres:
                <InputSelect @bind-Value="SelectedGenresIds" multiple>
                    <option value="-1" selected>None</option>
                    @foreach (Genre genre in GenresToSelectFrom)
                    {
                        <option value="@genre.Id.ToString()">@genre.Name</option>
                    }
                </InputSelect>
            </label>
        </p>
        <p>
            <label>
                Select localization:
                <InputSelect @bind-Value="SelectedLocalizationId">
                    <option value="-1" selected>None</option>
                    @foreach (Localization localization in LocalizationsToSelectFrom)
                    {
                        <option value="@localization.Id.ToString()">@localization.Name</option>
                    }
                </InputSelect>
            </label>
        </p>
        <p>
            <label>
                Select platforms:
                <InputSelect @bind-Value="SelectedPlatformsIds" multiple>
                    <option value="-1" selected>None</option>
                    @foreach (Platform platform in PlatformsToSelectFrom)
                    {
                        <option value="@platform.Id.ToString()">@platform.Name</option>
                    }
                </InputSelect>
            </label>
        </p>
        <p>
            <label>
                Select publisher:
                <InputSelect @bind-Value="SelectedPublishersIds" multiple>
                    <option value="-1" selected>None</option>
                    @foreach (Publisher publisher in PublishersToSelectFrom)
                    {
                        <option value="@publisher.Id.ToString()">@publisher.Name</option>
                    }
                </InputSelect>
            </label>
        </p>
        <p>
            <label>
                Enter image:
                <InputFile OnChange="FileUploaded" />
            </label>
            <div class="image-container">
                <img class="post-image" src="@ImageSource" alt="Изображение на странице игры для загрузки игры" title="Игра @Name" itemprop="image">
            </div>
        </p>

        <input type="submit" value="Submit" />
    }
</EditForm>