@page "/admin/games/games/add-game"
@using Domain.Games
@using BlazorClient.Components.PagesComponents.Common

<h3>Add game page</h3>

<a href="/admin/games/games/list-games" class="list-group-item link-dark">Игры</a>
<a href="/admin">К странице админа</a>

<EditForm OnValidSubmit="AddGameAsync" Model="this" Context="myContext">
    <DataAnnotationsValidator />
    <ValidationSummary />

    @if (DevelopersToSelectFrom is null || GenresToSelectFrom is null || LocalizationsToSelectFrom is null || PlatformsToSelectFrom is null || PublishersToSelectFrom is null)
    {
        <p>Загружается...</p>
    }
    else
    {
        <p>
            <label>
                Enter name:
                <InputText @bind-Value="@Name" />
                <ValidationMessage For="() => Name" />
            </label>
        </p>
        <p>
            <label>
                Enter release date:
                <InputDate @bind-Value="@ReleaseDate" />
                <ValidationMessage For="() => ReleaseDate" />
            </label>
        </p>
        <p>
            <label>
                Enter description:
                <InputTextArea @bind-Value="@Description" />
                <ValidationMessage For="() => Description" />
            </label>
        </p>
        <TrailerField @bind-Value="Trailer" />

        <p>
            <label>Select developers (порядок можно менять перетаскиванием):</label>
            <OrderedMultiSelect TItem="Developer"
                                TId="long"
                                AllItems="DevelopersToSelectFrom.ToList()"
                                IdSelector="d => d.Id"
                                DisplaySelector="d => d.Name"
                                Placeholder="Select developers..."
                                LabelPlural="разработчиков"
                                @bind-Items="SelectedDevelopers" />
        </p>

        <p>
            <label>Select genres (порядок можно менять перетаскиванием):</label>
            <OrderedMultiSelect TItem="Genre"
                                TId="long"
                                AllItems="GenresToSelectFrom.ToList()"
                                IdSelector="g => g.Id"
                                DisplaySelector="g => g.Name"
                                Placeholder="Select genres..."
                                LabelPlural="жанров"
                                @bind-Items="SelectedGenres" />
        </p>

        <p>
            <label>Select localization:</label>
            @{
                var locSelector = (Localization l) => (long?)l.Id;
                var locDisplay = (Localization l) => l.Name;
            }
            <SingleSelect TItem="Localization"
                          TId="long?"
                          Items="LocalizationsToSelectFrom.ToList()"
                          @bind-SelectedId="SelectedLocalizationId"
                          IdSelector="locSelector"
                          DisplaySelector="locDisplay"
                          Placeholder="Select localization..." />
        </p>

        <p>
            <label>Select platforms (порядок можно менять перетаскиванием):</label>
            <OrderedMultiSelect TItem="Platform"
                                TId="long"
                                AllItems="PlatformsToSelectFrom.ToList()"
                                IdSelector="p => p.Id"
                                DisplaySelector="p => p.Name"
                                Placeholder="Select platforms..."
                                LabelPlural="платформ"
                                @bind-Items="SelectedPlatforms" />
        </p>

        <p>
            <label>Select publishers (порядок можно менять перетаскиванием):</label>
            <OrderedMultiSelect TItem="Publisher"
                                TId="long"
                                AllItems="PublishersToSelectFrom.ToList()"
                                IdSelector="p => p.Id"
                                DisplaySelector="p => p.Name"
                                Placeholder="Select publishers..."
                                LabelPlural="издателей"
                                @bind-Items="SelectedPublishers" />
        </p>

        <p>
            <label>
                Enter image:
                <InputFile OnChange="FileUploaded" />
            </label>
            <div class="image-container">
                <img class="post-image" src="@ImageSource" alt="Изображение на странице игры для загрузки игры" title="Игра @Name" itemprop="image">
            </div>
        </p>

        <input type="submit" value="Submit" />
    }
</EditForm>