@page "/admin/games/remove-game/{Id:long}"
@using Domain.Games
@using Domain.RequestsModels.Games
@inherits RemoveEntityPageBase<Game, AddGameModel, UpdateGameModel>

<AuthorizeView Policy="Admin">
    <Authorized>
        <a href="/admin">К странице админа</a>
        @if (Entity is null)
        {
            <p>Загружается...</p>
        }
        else
        {
            <a href="/admin/games/games/list-games" class="list-group-item link-dark">Игры</a>

            <h3>Удалить @Entity.Name</h3>
            <p>Вы уверены, что хотите удалить эту игру?</p>
            <p>
                <button type="button" @onclick="RemoveAsync">Удалить</button>
            </p>
        }
    </Authorized>
    <NotAuthorized>
        <a href="/auth/login">Авторизируйся</a> или <a href="/auth/register">Зарегистрируйся</a> админом, чтобы удалить игру
    </NotAuthorized>
</AuthorizeView>