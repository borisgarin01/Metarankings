@page "/admin/games/developers/remove-developer/{Id:long}"
@using Domain.Games
@using Domain.RequestsModels.Games.Developers
@inherits RemoveEntityPageBase<Developer, AddDeveloperModel, UpdateDeveloperModel>

<AuthorizeView Policy="Admin">
    <Authorized>
        <a href="/admin">К странице админа</a>
        @if (Entity is null)
        {
            <p>Загружается...</p>
        }
        else
        {
            <a href="/admin/games/developers/list-developers" class="list-group-item link-dark">Разработчики</a>

            <h3>Удалить @Entity.Name</h3>
            <p>Вы уверены, что хотите удалить этого разработчика?</p>
            <p>
                <button type="button" @onclick="RemoveAsync">Удалить</button>
            </p>
        }
    </Authorized>
    <NotAuthorized>
        <a href="/auth/login">Авторизируйся</a> или <a href="/auth/register">Зарегистрируйся</a> админом, чтобы удалить разраба
    </NotAuthorized>
</AuthorizeView>