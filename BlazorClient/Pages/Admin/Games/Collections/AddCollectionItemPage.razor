@page "/admin/games/collections/{Id:long}/add-games"
@using Domain.Games

<h3>AddCollectionItemPage</h3>

<AuthorizeView Policy="Admin">
    <Authorized>
        <EditForm OnValidSubmit="@AddGameCollectionItemAsync" Model="this" Context="myContext">
            <div>
                <InputText @bind-Value="SearchTerm" placeholder="Поиск игры..." />

                <InputSelect @bind-Value="SelectedGameId">
                    <option value="-1">None</option>
                    @foreach (Game game in filteredGames)
                    {
                        <option value="@game.Id">@game.Name</option>
                    }
                </InputSelect>

                <input type="submit" value="Add" />
            </div>
        </EditForm>
    </Authorized>
    <NotAuthorized>
        <a href="/auth/login">Авторизируйся</a> или <a href="/auth/register">Зарегистрируйся</a> админом, чтобы добавить игру в подборку
    </NotAuthorized>
</AuthorizeView>