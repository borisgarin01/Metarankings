@page "/admin/games/platforms/remove-platform/{Id:long}"
@using Domain.Games
@using Domain.RequestsModels.Games.Platforms
@inherits RemoveEntityPageBase<Platform, AddPlatformModel, UpdatePlatformModel>

<AuthorizeView Policy="Admin">
    <Authorized>
        <a href="/admin">К странице админа</a>
        <a href="/admin/games/platforms/list-platforms" class="list-group-item link-dark">Платформы</a>
        @if (Entity is null)
        {
            <p>Загружается...</p>
        }
        else
        {
            <h3>Удалить @Entity.Name</h3>
            <p>Вы уверены, что хотите удалить эту платформу?</p>
            <p>
                <button type="button" @onclick="RemoveAsync">Удалить</button>
            </p>
        }
    </Authorized>
    <NotAuthorized>
        <a href="/auth/login">Авторизируйся</a> или <a href="/auth/register">Зарегистрируйся</a> админом, чтобы удалить платформу
    </NotAuthorized>
</AuthorizeView>