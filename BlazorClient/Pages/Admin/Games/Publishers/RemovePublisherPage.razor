@page "/admin/Games/publishers/remove-publisher/{Id:long}"
@using Domain.Games
@using Domain.RequestsModels.Games.Publishers
@inherits RemoveEntityPageBase<Publisher, AddPublisherModel, UpdatePublisherModel>

<AuthorizeView Policy="Admin">
    <Authorized>
        <a href="/admin">К странице админа</a>
        <a href="/admin/games/publishers/list-publishers" class="list-group-item link-dark">Издатели</a>

        @if (Entity is null)
        {
            <p>Загружается...</p>
        }
        else
        {
            <h3>Удалить @Entity.Name</h3>
            <p>Вы уверены, что хотите удалить этого издателя?</p>
            <p>
                <button type="button" @onclick="RemoveAsync">Удалить</button>
            </p>
        }
    </Authorized>
    <NotAuthorized>
        <a href="/auth/login">Авторизируйся</a> или <a href="/auth/register">Зарегистрируйся</a> админом, чтобы удалить издателя
    </NotAuthorized>
</AuthorizeView>