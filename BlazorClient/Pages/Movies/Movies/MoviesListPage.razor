@page "/movies/best-movies"
@using BlazorClient.Components.PagesComponents.MoviesList
@using Domain.Movies

<div class="moviesList">
    @if (Movies is null)
    {
        <p>Загружается...</p>
    }
    else
    {
        foreach (Movie movie in Movies)
        {
            <MoviePost Id="@movie.Id"
                       Name="@movie.Name"
                       Image="@movie.ImageSource"
                       ViewersScoresCount="@movie.UsersReviewsCount"
                       CriticsScoresCount="@movie.CriticsReviewsCount"
                       Genres="@movie.MovieGenres"
                       ReleaseDate="@movie.PremierDate"
                       Description="@movie.Description" />
        }
    }
</div>