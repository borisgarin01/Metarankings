@page "/movies/genres/{GenreId:long}"
@using BlazorClient.Components.PagesComponents.MoviesList

@if (Genre is null)
{
    <p>Загружается...</p>
}
else if (!Genre.Movies.Any())
{
    <p>В этом жанре пока нет фильмов.</p>
}
else
{
    <div id="loop" class="list clear">
        @foreach (var movie in Genre.Movies)
        {
            <MoviePost CriticsScoresCount="@movie.CriticsReviewsCount"
                       Id="@movie.Id"
                       Description="@movie.Description"
                       Genres="@movie.MovieGenres"
                       Image="@movie.ImageSource"
                       Name="@movie.Name"
                       ReleaseDate="@movie.PremierDate"
                       ViewersScoresCount="@movie.UsersReviewsCount" />

        }
    </div>
}