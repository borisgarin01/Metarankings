@page "/publishers/{PublisherId:int}"

@using BlazorClient.Components.PagesComponents.GamesList
@using BlazorClient.Pages.Games.Games
@using Domain

<BlazorClient.Components.PagesComponents.Common.Headerer />
<BlazorClient.Components.PagesComponents.Common.GameMenu Year="@DateTime.Today.Year" />

@if (Publisher is null)
{
    <p>Загружается...</p>
}
else
{
    <div class="content-title">
        <h1>@Publisher.Name</h1>
    </div>

    <div id="filter">
        <div class="filter-nav">
            <div class="filter-name">Студии</div>
            <div class="filter-menu">
                <a href="/games/best-games?developerId=1">Naughty Dog</a>
                <a href="/games/best-games?developerId=2">Sony Santa Monica</a>
                <a href="/games/best-games?developerId=3">CD Projekt RED</a>
                <a href="/games/best-games?developerId=4">Rockstar Games</a>
                <a href="/games/best-games?developerId=5">Sandfall Interactive</a>
                <a href="/games/best-games?developerId=6">Studio Tolima</a>
                <a href="/games/best-games?developerId=7">Larian Studios</a>
                <a href="/games/best-games?developerId=8">Nintendo</a>
                <a href="/games/best-games?developerId=9">Capcom</a>
                <a href="/games/best-games?developerId=10">Nintendo EAD</a>
                <a href="/games/best-games?developerId=11">FromSoftware</a>
            </div>
        </div>
        <BestGamesOfYearsComponent Year="@DateTime.Today.Year" />
        <BestGamesOfPlatformsComponent Platforms="@Platforms" />
        <h2>Новые игры</h2>
    </div>

    <div id="loop" class="list clear">
        @foreach (var game in Publisher.Games)
        {
            <BlazorClient.Components.PagesComponents.PublisherDetails.PublisherGameComponent Game="@game" />
        }
    </div>
}
