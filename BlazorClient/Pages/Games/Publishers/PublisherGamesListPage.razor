@page "/publishers/{PublisherId:int}"

@using BlazorClient.Components.PagesComponents.GamesList
@using Domain.Games

<BlazorClient.Components.PagesComponents.Common.GameMenu Year="@DateTime.Today.Year" />

@if (Publisher is null)
{
    <p>Загружается...</p>
}
else
{
    <div class="content-title">
        <h1>@Publisher.Name</h1>
    </div>

    <div id="filter">
        <div class="filter-nav">
            <div class="filter-name">Студии</div>
            <div class="filter-menu">
                @foreach (Developer developer in Developers)
                {
                    <a href="/games/best-games?developerId=@developer.Id">@developer.Name</a>
                }
            </div>
        </div>
        <BestGamesOfYearsComponent Year="@DateTime.Today.Year" />
        <BestGamesOfPlatformsComponent Platforms="@Platforms" />
        <h2>Новые игры</h2>
    </div>

    <div id="loop" class="list clear">
        @foreach (var game in Publisher.Games)
        {
            <BlazorClient.Components.PagesComponents.PublisherDetails.PublisherGameComponent Game="@game" />
        }
    </div>
}
