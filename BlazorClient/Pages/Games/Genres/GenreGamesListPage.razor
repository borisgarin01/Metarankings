@page "/games/genres/{GenreId:long}"

@if (Genre is null)
{
    <p>Загружается...</p>
}
else if (!Genre.Games.Any())
{
    <p>В этом жанре пока нет игр.</p>
}
else
{
    <div id="loop" class="list clear">
        @foreach (var game in Genre.Games)
        {
            <BlazorClient.Components.PagesComponents.GamesList.GamePost Description="@game.Description"
                                                                        Developers="@game.Developers"
                                                                        Id="@game.Id"
                                                                        Genres="@game.Genres"
                                                                        Image="@game.Image"
                                                                        Localization="@game.Localization"
                                                                        Name="@game.Name"
                                                                        Platforms="@game.Platforms"
                                                                        Publishers="@game.Publishers"
                                                                        ReleaseDate="@game.ReleaseDate"
                                                                        Score="@MathF.Round(game.UsersScore,1)"
                                                                        ScoresCount="@game.UsersReviewsCount" />
        }
    </div>
}