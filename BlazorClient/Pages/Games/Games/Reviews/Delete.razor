@page "/games/reviews/delete/{Id:long}"

<AuthorizeView>
    <Authorized Context="authContext">
        <div id="container">
            <div id="content">
                <div class="content-title">
                    <h1>Delete Review</h1>
                </div>

                @if (GameReview is not null)
                {
                    <div class="post-content" style="margin-left: 0;">
                        <div class="delete-warning">
                            <h2>Are you sure you want to delete this review?</h2>

                            <div class="rating">
                                <h2>Score</h2>
                                <div class="small-score mark-@(Math.Round(GameReview.Score))">
                                    @GameReview.Score
                                </div>
                            </div>

                            <div>
                                <h2>Review Text</h2>
                                <div class="post-content" style="margin-left: 0;">
                                    @GameReview.TextContent
                                </div>
                            </div>

                            <div class="delete-actions">
                                <button class="links-add delete-btn" @onclick="DeleteAsync">
                                    Delete Review
                                </button>
                                <a href="/games/Details/@GameReview.GameId" class="links-add cancel-btn">
                                    Cancel
                                </a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="post-content" style="margin-left: 0;">
                        <p>Loading...</p>
                    </div>
                }
            </div>

            <div class="sidebar">
                <div class="widget">
                    <h2>Warning</h2>
                    <div class="textwidget">
                        <p>This action cannot be undone!</p>
                        <p>Deleting this review will permanently remove it from the system.</p>
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div id="container">
            <div id="content">
                <div class="content-title">
                    <h1>Access Denied</h1>
                </div>
                <div class="post-content" style="margin-left: 0;">
                    <p>
                        Please
                        <a href="/auth/login">Authorize</a>
                        or
                        <a href="/auth/register">Register</a>
                        to delete reviews.
                    </p>
                </div>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>
