@page "/games/reviews/edit/{Id:long}"

<AuthorizeView>
    <Authorized Context="authContext">
        @if (UpdateGamePlayerReviewModel is not null)
        {
            <div id="container">
                <div id="content">
                    <div class="content-title">
                        <h1>Edit Review</h1>
                    </div>

                    <EditForm Model="UpdateGamePlayerReviewModel" OnValidSubmit="UpdateAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="post-content" style="margin-left: 0;">
                            <div class="rating">
                                <h2>Score (0-10)</h2>

                                <!-- ЗВЕЗДЫ ДЛЯ РЕДАКТИРОВАНИЯ -->
                                <div style="display: flex; gap: 5px; flex-wrap: wrap; padding: 10px 0;">
                                    @for (int i = 1; i <= 10; i++)
                                    {
                                        var starIndex = i;
                                        var isActive = starIndex <= UpdateGamePlayerReviewModel.Score;
                                        var imageUrl = GetStarImage(starIndex, isActive);

                                        <img src="@imageUrl"
                                             alt="@starIndex"
                                             style="cursor: pointer; width: 30px; height: 30px;"
                                             @onclick="() => SetScore(starIndex)"
                                             @onmouseover="() => HoverScore(starIndex)"
                                             @onmouseout="ResetHover"
                                             @key="starIndex" />
                                    }
                                </div>
                                <span style="font-size: 18px; color: #555;">
                                    / 10 (выбрано: @UpdateGamePlayerReviewModel.Score)
                                </span>
                            </div>

                            <div>
                                <h2>Review Text</h2>
                                <InputTextArea class="textarea"
                                               @bind-Value="UpdateGamePlayerReviewModel.TextContent"
                                               rows="6" />
                            </div>

                            <button type="submit" class="links-add">
                                Update Review
                            </button>
                        </div>
                    </EditForm>
                </div>

                <div class="sidebar">
                    <div class="widget">
                        <h2>Information</h2>
                        <div class="textwidget">
                            <p>Edit your review for this game.</p>
                            <p>Score should be between 0 and 10.</p>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div id="container">
                <div id="content">
                    <div class="post-content" style="margin-left: 0;">
                        <p>Loading...</p>
                    </div>
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div id="container">
            <div id="content">
                <div class="content-title">
                    <h1>Access Denied</h1>
                </div>
                <div class="post-content" style="margin-left: 0;">
                    <p>
                        Please
                        <a href="/auth/login">Authorize</a>
                        or
                        <a href="/auth/register">Register</a>
                        to edit reviews.
                    </p>
                </div>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>