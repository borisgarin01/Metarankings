@using BlazorClient.PagesModels.Games.Reviews
@using Domain.RequestsModels.Games.GamesGamersReviews
@using Blazored.Toast.Services

<AuthorizeView>
    <Authorized Context="authContext">
        <div id="container">
            <div id="content">
                <div id="comments">
                    <h1 id="users">Add Review</h1>

                    <EditForm Model="YourScoreComponentModel" OnValidSubmit="AddReviewAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div id="respond" class="comment-respond">
                            <div id="reply-title" class="comment-reply-title">
                                <h2>Your Score</h2>
                            </div>

                            <div class="your-score">
                                @for (int i = 1; i <= 10; i++)
                                {
                                    int score = i;
                                    string image = score <= YourScoreComponentModel.YourScore ? "rating_on.gif" : "rating_off.gif";
                                    <img src="/images/@image"
                                         alt="@score"
                                         style="cursor: pointer; width: 30px; height: 30px;"
                                         @onclick="@(() => SetScore(score))" />
                                }
                            </div>

                            <div class="commform-author">
                                <p>Your Score: @YourScoreComponentModel.YourScore / 10</p>
                            </div>

                            <div>
                                <div>
                                    <label for="comment">Review Text</label>
                                    <InputTextArea @bind-Value="YourScoreComponentModel.Text"
                                                   rows="6" />
                                </div>
                            </div>

                            <p class="form-submit">
                                <input type="submit" id="submit" value="Add Review">
                            </p>
                        </div>
                    </EditForm>
                </div>
            </div>

            <div class="sidebar">
                <div class="widget">
                    <h2>Information</h2>
                    <div class="textwidget">
                        <p>Share your opinion about this game.</p>
                        <p>Rate it from 0 to 10.</p>
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div id="container">
            <div id="content">
                <div id="comments">
                    <h1 id="users">Access Denied</h1>
                    <div class="post-content" style="margin-left: 0;">
                        <p>
                            Please
                            <a href="/auth/login">Authorize</a>
                            or
                            <a href="/auth/register">Register</a>
                            to add a review.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>