@page "/games/most-waiting-games"
@using System.Globalization
@using BlazorClient.Components.PagesComponents.Common
@using Domain.Games

<div class="wrapper">
    <GameMenu Year="@DateTime.Now.AddYears(1).Year" />

    <div id="container" class="clear">
        <div class="sidebar">
        </div>

        <div id="content" class="lcol">
            <div class="content-title">
                <h1>Самые ожидаемые игры</h1>
            </div>

            <div id="filter">
                <div class="filter-nav">
                    <div class="filter-name">Платформа</div>
                    <div class="filter-menu">
                        <a class="@(PlatformId is null ? "selected" : "")"
                           href="@GetPageUrl(1)">Все</a>
                        @foreach (Platform platform in GamesPlatforms)
                        {
                            <a class="@(PlatformId == platform.Id ? "selected" : "")"
                               href="@BuildQueryString(page: 1, platformId: platform.Id)">
                                @platform.Name
                            </a>
                        }
                    </div>
                </div>

                <div class="filter-nav">
                    <div class="filter-name">Жанр</div>
                    <div class="filter-menu">
                        <a class="@(GenreId is null ? "selected" : "")"
                           href="@GetPageUrl(1)">Все</a>
                        @foreach (Genre genre in GamesGenres)
                        {
                            <a class="@(GenreId == genre.Id ? "selected" : "")"
                               href="@BuildQueryString(page: 1, genreId: genre.Id)">
                                @genre.Name
                            </a>
                        }
                    </div>
                </div>
            </div>

            <section id="loop" class="list clear best game">
                @if (isLoading)
                {
                    <p>Загружается...</p>
                }
                else if (!FutureGames.Any())
                {
                    <p>Ничего не найдено.</p>
                }
                else
                {
                    int order = 1;
                    foreach (Game game in FutureGames)
                    {
                        <article class="post clear game" @key="game.Id">
                            <a href="/games/details/@game.Id" class="thumb">
                                <img class="post-image" src="@game.Image" alt="@game.Name">
                            </a>
                            <div class="best-prod">
                                <div class="counter">@order</div>
                            </div>
                            <a class="name" href="/games/details/@game.Id">@game.Name</a>
                            <div class="post-meta">
                                @(game.ReleaseDate.HasValue
                                    ? game.ReleaseDate.Value.ToString("dd MMMM yyyy", new CultureInfo("ru-RU"))
                                    : "Скоро")
                            </div>
                            <div class="post-meta">@game.Description</div>
                            <div class="wait">
                                <span class="w-yes">
                                    <span class="ldc-ul_wait" onclick="alter_ul_post_values(this,'@game.Id','like')">
                                        + <span>972</span>
                                    </span>
                                </span>
                                <span class="w-no">
                                    <span class="ldc-ul_wait" onclick="alter_ul_post_values(this,'@game.Id','dislike')">
                                        - <span>85</span>
                                    </span>
                                </span>
                                Ожидания: 91%
                            </div>
                            <div class="trailer" data-video="/games/details/@game.Id/#content-trailer"></div>
                        </article>
                        order++;
                    }
                }
            </section>

            @* ПАГИНАЦИЯ *@
            @if (TotalPages > 1)
            {
                <div class="pagination">
                    <div class="navi">
                        @if (currentPage > 1)
                        {
                            <a class="prev page-numbers" href="@GetPageUrl(currentPage - 1)">← Предыдущая</a>
                        }

                        @{
                            int startPage = Math.Max(1, currentPage - 2);
                            int endPage = Math.Min(TotalPages, currentPage + 2);

                            if (startPage > 1)
                            {
                                <a class="page-numbers" href="@GetPageUrl(1)">1</a>
                                if (startPage > 2)
                                {
                                    <span class="page-numbers dots">…</span>
                                }
                            }

                            for (int i = startPage; i <= endPage; i++)
                            {
                                if (i == currentPage)
                                {
                                    <span class="page-numbers current">@i</span>
                                }
                                else
                                {
                                    <a class="page-numbers" href="@GetPageUrl(i)">@i</a>
                                }
                            }

                            if (endPage < TotalPages)
                            {
                                if (endPage < TotalPages - 1)
                                {
                                    <span class="page-numbers dots">…</span>
                                }
                                <a class="page-numbers" href="@GetPageUrl(TotalPages)">@TotalPages</a>
                            }
                        }

                        @if (currentPage < TotalPages)
                        {
                            <a class="next page-numbers" href="@GetPageUrl(currentPage + 1)">Показать еще</a>
                        }
                    </div>
                </div>
            }

