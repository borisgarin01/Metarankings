@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

<div class="post clear">
    <a href="/games/details/@Game.Id" title="Игра «@Game.Name»" class="thumb"><img class="post-image" src="@Game.Image" alt="@Game.Name"></a>
    <div class="best-prod">
        <div class="counter">@(Order)</div>
        <span class="star">★</span>
    </div>
    <a class="name" href="/games/Details/@Game.Id">@Game.Name</a>
    <div class="post-meta"><p>@string.Join(", ", Game.Genres.Select(a => a.Name))</p></div><div class="post-meta"><p>@string.Join(", ", Game.Platforms.Select(a => a.Name))</p></div>
    <div class="post-meta"><p>Дата выхода: @Game.ReleaseDate.Value.ToString("dd MM yyyy") года</p></div>
    <div class="post-meta">Входит в лучшие по мнению 83% пользователей</div>
    <div class="post-content">@Game.Description</div>
    <div class="trailer" data-video="@Game.Trailer"></div>
    <div class="ratings-graph">
        <div class="graph-critic">
            <div class="graph">
                <div class="small-score mark-@Math.Round(Game.CriticsScore)">@Math.Round(Game.CriticsScore)</div>
                Рейтинг критиков
                <div class="graph-body">
                    <div style="width:@(Math.Round(Game.CriticsScore, 1) * 10)%" class="rating-graph mark-@Math.Round(Game.CriticsScore)"></div>
                </div>
            </div>
        </div>
        <div class="graph-critic">
            <div class="graph">
                <div class="small-score mark-@Math.Round(Game.UsersScore)">@Math.Round(Game.UsersScore, 1)</div>
                Игроки
                <div class="graph-body">
                    <div class="rating-graph mark-@Math.Round(Game.UsersScore)" style="width:@(Math.Round(Game.UsersScore, 1) * 10)%"></div>
                </div>
            </div>
        </div>
    </div>
</div>