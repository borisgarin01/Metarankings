@page "/search"
@using Domain.Games
@using Domain.Movies

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h3 class="display-6 text-primary">
                <i class="bi bi-search"></i> Search page
            </h3>
            <hr />
        </div>
    </div>

    <div class="row mb-4">
        <div class="col">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form @onsubmit="PerformSearch" @onsubmit:preventDefault>
                        <div class="row g-3">
                            <div class="col-md-10">
                                <label for="searchInput" class="form-label text-muted mb-2">
                                    <i class="bi bi-pencil-square"></i> Новый поисковый запрос
                                </label>
                                <input type="text"
                                       class="form-control form-control-lg"
                                       id="searchInput"
                                       placeholder="Введите название игры или фильма..."
                                       @bind="SearchText"
                                       @bind:event="oninput" />
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary btn-lg w-100" disabIed="@IsSearching">
                                    @if (IsSearching)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    }
                                    <i class="bi bi-search"></i> Искать
                                </button>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(SearchText))
                        {
                            <div class="mt-2">
                                <small class="text-muted">
                                    <i class="bi bi-info-circle"></i> Результаты поиска: <strong>@SearchText</strong>
                                    <button type="button" class="btn btn-link btn-sm p-0 ms-2" @onclick="ClearSearch">
                                        <i class="bi bi-x-circle"></i> Очистить
                                    </button>
                                </small>
                            </div>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (Games is null || Movies is null)
    {
        <div class="alert alert-info text-center py-5" role="alert">
            <div class="spinner-border text-primary mb-3" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h4 class="alert-heading">Searching for something more...</h4>
            <p class="mb-0">Пожалуйста, подождите, мы ищем для вас лучшие результаты</p>
        </div>
    }
    else
    {
        @if (!Games.Any() && !Movies.Any())
        {
            <div class="alert alert-warning text-center py-5" role="alert">
                <i class="bi bi-emoji-frown" style="font-size: 3rem;"></i>
                <h4 class="alert-heading mt-3">Ничего не нашли :(</h4>
                <p class="mb-0">Попробуйте изменить поисковый запрос или проверьте правильность написания</p>
            </div>
        }
        else
        {
            <div class="alert alert-success" role="alert">
                <i class="bi bi-info-circle-fill"></i>
                Результаты поиска по запросу <strong>«@SearchText»</strong>
                <span class="badge bg-secondary ms-2">
                    @(Games.Count() + Movies.Count()) найдено
                </span>
            </div>

            <div class="row">
                @if (Games.Any())
                {
                    <div class="col-md-6 mb-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-header bg-primary text-white">
                                <h4 class="card-title mb-0">
                                    <i class="bi bi-controller"></i> Игры
                                    <span class="badge bg-light text-dark ms-2">@Games.Count()</span>
                                </h4>
                            </div>
                            <div class="card-body">
                                @if (Games.Count() > 0)
                                {
                                    <div class="list-group list-group-flush">
                                        @foreach (Game game in Games)
                                        {
                                            <a href="/games/details/@game.Id"
                                               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                                <div>
                                                    <i class="bi bi-play-circle-fill text-primary me-2"></i>
                                                    @game.Name
                                                </div>
                                                <i class="bi bi-chevron-right text-muted"></i>
                                            </a>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="card-footer bg-transparent">
                                <a href="/games" class="btn btn-outline-primary btn-sm">Все игры →</a>
                            </div>
                        </div>
                    </div>
                }

                @if (Movies.Any())
                {
                    <div class="col-md-6 mb-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-header bg-danger text-white">
                                <h4 class="card-title mb-0">
                                    <i class="bi bi-film"></i> Фильмы
                                    <span class="badge bg-light text-dark ms-2">@Movies.Count()</span>
                                </h4>
                            </div>
                            <div class="card-body">
                                @if (Movies.Count() > 0)
                                {
                                    <div class="list-group list-group-flush">
                                        @foreach (Movie movie in Movies)
                                        {
                                            <a href="/movies/details/@movie.Id"
                                               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                                <div>
                                                    <i class="bi bi-camera-reels-fill text-danger me-2"></i>
                                                    @movie.Name
                                                </div>
                                                <i class="bi bi-chevron-right text-muted"></i>
                                            </a>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="card-footer bg-transparent">
                                <a href="/movies" class="btn btn-outline-danger btn-sm">Все фильмы →</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>