@page "/search"
@using Domain.Games
@using Domain.Movies
@using System.Globalization
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h3 class="display-6 text-primary">
                <i class="bi bi-search"></i> Search page
            </h3>
            <hr />
        </div>
    </div>

    <div class="row mb-4">
        <div class="col">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form @onsubmit="PerformSearch" @onsubmit:preventDefault>
                        <div class="row g-3">
                            <div class="col-md-10">
                                <label for="searchInput" class="form-label text-muted mb-2">
                                    <i class="bi bi-pencil-square"></i> Новый поисковый запрос
                                </label>
                                <input type="text"
                                       class="form-control form-control-lg"
                                       id="searchInput"
                                       placeholder="Введите название игры или фильма..."
                                       @bind="SearchText"
                                       @bind:event="oninput" />
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary btn-lg w-100" disabIed="@IsSearching">
                                    @if (IsSearching)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    }
                                    <i class="bi bi-search"></i> Искать
                                </button>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(SearchText))
                        {
                            <div class="mt-2">
                                <small class="text-muted">
                                    <i class="bi bi-info-circle"></i> Результаты поиска: <strong>@SearchText</strong>
                                    <button type="button" class="btn btn-link btn-sm p-0 ms-2" @onclick="ClearSearch">
                                        <i class="bi bi-x-circle"></i> Очистить
                                    </button>
                                </small>
                            </div>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (Games is null || Movies is null)
    {
        <div class="alert alert-info text-center py-5" role="alert">
            <div class="spinner-border text-primary mb-3" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h4 class="alert-heading">Searching for something more...</h4>
            <p class="mb-0">Пожалуйста, подождите, мы ищем для вас лучшие результаты</p>
        </div>
    }
    else
    {
        @if (!Games.Any() && !Movies.Any())
        {
            <div class="alert alert-warning text-center py-5" role="alert">
                <i class="bi bi-emoji-frown" style="font-size: 3rem;"></i>
                <h4 class="alert-heading mt-3">Ничего не нашли :(</h4>
                <p class="mb-0">Попробуйте изменить поисковый запрос или проверьте правильность написания</p>
            </div>
        }
        else
        {
            <div class="post-info"><p>Ниже представлены все результаты поиска по запросу: @SearchText</p></div>
            <div id="loop" class="list clear">
                <div class="specials-index">
                </div>
                @if (Movies.Any())
                {
                    <div class="index-movies">
                        <h3><a href="/movies/new-movies/">Фильмы</a></h3>
                        @foreach (Movie movie in Movies)
                        {
                            <div class="item">
                                <a href="/movies/details/@movie.Id" title="Фильм @movie.Name"><img class="post-image" src="@movie.ImageSource" alt="@movie.Name"></a>
                                <div class="small-score mark-@(movie.MovieReviews.Any() ? Math.Round(movie.MovieReviews.Average(mr => mr.Score)) : 0)">
                                    <span data-title="Рейтинг фильма" class="tooltip">@(movie.MovieReviews.Any() ? Math.Round(movie.MovieReviews.Average(mr => mr.Score)) : 0)</span>
                                </div>
                                <span class="item-name"><a href="/movies/details/@movie.Id">@movie.Name</a></span>
                                <span class="item-meta">
                                    @for (int i = 0; i < movie.MovieGenres.Count - 1; i++)
                                    {
                                        <a href="/movies/genres/@movie.MovieGenres[i].Id">@movie.MovieGenres[i].Name</a>
                                    }
                                    <a href="/movies/genres/@movie.MovieGenres[movie.MovieGenres.Count - 1].Id">@movie.MovieGenres[movie.MovieGenres.Count - 1].Name</a>
                                </span>
                                <span class="item-meta">
                                    <a href="/movies/details/@movie.Id/#reviews">Рецензии (@movie.MovieReviews.Count)</a>
                                    <a href="/movies/details/@movie.Id/#comments">Отзывы (@movie.MovieReviews.Count)</a>
                                </span>
                                <span class="item-meta" style="display: block;">
                                    @(movie.PremierDate.HasValue ? movie.PremierDate.Value.ToString("dd MMMM yyyy", new CultureInfo("ru-RU")) : "Нет даты премьеры")
                                </span>
                                <span class="item-description">@string.Join(" ", movie.Description.Split(' ').Take(12))...</span>
                            </div>
                        }
                    </div>
                }
                @if (Games.Any())
                {
                    <div class="index-games">
                        <h3>
                            <a href="/games/new-games/">Игры</a>
                        </h3>
                        @foreach (Game game in Games)
                        {
                            <div class="item">
                                <a href="/games/details/@game.Id" title="Игра @game.Name"><img class="post-image" src="@game.Image" alt="@game.Name"></a>
                                <div class="small-score mark-@(game.GamesPlayersReviews.Any() ? Math.Round(game.GamesPlayersReviews.Average(mr => mr.Score)) : 0)">
                                    <span data-title="Рейтинг игры" class="tooltip">@(game.GamesPlayersReviews.Any() ? Math.Round(game.GamesPlayersReviews.Average(mr => mr.Score), 1) : 0)</span>
                                </div>
                                <span class="item-name"><a href="/games/details/@game.Id">@game.Name</a></span>
                                <span class="item-meta">
                                    @for (int i = 0; i < game.Genres.Count - 1; i++)
                                    {
                                        <a href="/games/genres/@game.Genres[i].Id">@game.Genres[i].Name</a>
                                    }
                                    <a href="/games/genres/@game.Genres[game.Genres.Count - 1].Id">@game.Genres[game.Genres.Count - 1].Name</a>
                                </span>
                                <span class="item-meta"><a href="/games/details/@game.Id/#reviews">Рецензии (@game.GamesPlayersReviews.Count)</a> <a href="/games/details/@game.Id/#comments">Отзывы (@game.GamesPlayersReviews.Count)</a></span>
                                <span class="item-meta" style="display: block;">
                                    @(game.ReleaseDate.HasValue ? game.ReleaseDate.Value.ToString("dd MMMM yyyy", new CultureInfo("ru-RU")) : "Нет даты релиза")
                                </span>
                                <span class="item-description">@string.Join(" ", game.Description.Split(' ').Take(12))...</span>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
</div>