@page "/search"
@using Domain.Games
@using Domain.Movies

<h3>Search page</h3>


@if (Games is null || Movies is null)
{
    <p>Searching for something more...</p>
}

else
{
    @if (!Games.Any() && !Movies.Any())
    {
        <p>Ничего не нашли :(</p>
    }
    else
    {
        <p>Результаты поиска по запросу @Text</p>

        if (Games.Any())
        {
            <div class="found_games">
                <h4 class="search_results_title">Игры</h4>
                <ul class="search_results_list">
                    @foreach (Game game in Games)
                    {
                        <li class="search_result_list_item"><a href="/games/details/@game.Id">@game.Name</a></li>
                    }
                </ul>
            </div>
        }

        if (Movies.Any())
        {
            <div class="found_movies">
                <h4 class="search_result_title">Фильмы</h4>
                <ul class="search_results_list">
                    @foreach (Movie movie in Movies)
                    {
                        <li class="search_result_list_item"><a href="/movies/details/@movie.Id">@movie.Name</a></li>
                    }
                </ul>
            </div>
        }
    }
}