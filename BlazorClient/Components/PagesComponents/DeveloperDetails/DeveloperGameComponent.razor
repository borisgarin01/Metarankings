@using System.Globalization
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

<div class="post clear">
    <a href="/games/details/@Game.Id" title="«@Game.Name»" class="thumb">
        <img class="post-image" src="@Game.Image" alt="@Game.Name">
    </a>
    <h3><a class="name" href="/games/details/@Game.Id">@Game.Name</a></h3>
    <div class="post-meta"><p>@string.Join(", ", Game.Platforms.Select(b => b.Name))</p></div>
    <div class="post-meta"><p>@string.Join(", ", Game.Genres.Select(b => b.Name))</p></div>
    <div class="post-meta">
        @if (Game.ReleaseDate.HasValue)
        {
            <p>@Game.ReleaseDate.Value.ToString("dd MMMM yyyy", CultureInfo.GetCultureInfo("ru-RU"))</p>
        }
    </div>
    <div class="trailer" data-video="/games/details/@Game.Id/#content-trailer"></div>
    <div class="ratings-graph">
        <div class="graph">
            <div class="small-score mark-@Math.Round(Game.UsersScore)">@Math.Round(Game.UsersScore, 1)</div>
            <div class="graph-body"><div style="width:@(Math.Round(Game.UsersScore, 1) * 10)%" class="rating-graph mark-@Math.Round(Game.UsersScore)"></div></div>
        </div>
    </div>
</div>