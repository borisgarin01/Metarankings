<!-- Фильтр по годам -->
<div class="filter-nav">
    <div class="filter-name">Год</div>
    <div class="filter-menu">
        @{
            int currentYear = DateTime.Today.Year;
            int count = 9;

            // Явно проверяем, есть ли Year в URL
            bool isAllYears = !Year.HasValue;

            // Вычисляем startYear только если выбран конкретный год
            int startYear = currentYear;
            if (Year.HasValue)
            {
                int selectedYear = Year.Value;
                startYear = selectedYear + 3;

                if (selectedYear > currentYear - 4)
                {
                    startYear = currentYear;
                }

                if (startYear > currentYear)
                {
                    startYear = currentYear;
                }
            }
        }

        <!-- Ссылка "Все" -->
        @{
            string allYearsQueryParams = "";

            if (PlatformId.HasValue)
                allYearsQueryParams += $"&PlatformId={PlatformId}";

            if (GenreId.HasValue)
                allYearsQueryParams += $"&GenreId={GenreId}";

            if (!string.IsNullOrEmpty(allYearsQueryParams))
                allYearsQueryParams = "?" + allYearsQueryParams.TrimStart('&') + "&Page=1";
            else
                allYearsQueryParams = "?Page=1";
        }
        <a href="/games/best-games/@allYearsQueryParams"
           class="@(isAllYears ? "selected" : "")">
            Все
        </a>

        @for (int i = 0; i < count; i++)
        {
            int yearToShow = startYear - i;

            string queryParams = $"?Year={yearToShow}&Page=1";

            if (PlatformId.HasValue)
                queryParams += $"&PlatformId={PlatformId}";

            if (GenreId.HasValue)
                queryParams += $"&GenreId={GenreId}";

            <a href="/games/best-games/@queryParams"
               class="@(Year.HasValue && yearToShow == Year.Value ? "selected" : "")">
                @yearToShow
            </a>
        }
    </div>
</div>