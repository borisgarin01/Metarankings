<!-- Фильтр по годам -->
<div class="filter-nav">
    <div class="filter-name">Год</div>
    <div class="filter-menu">
        @{
            int currentYear = DateTime.Today.Year;
            int count = 9; // 9 лет после "Все"
            int selectedYear = Year ?? currentYear;
            bool showAllYears = !Year.HasValue; // Проверяем, выбран ли "Все"

            int startYear = selectedYear + 3;

            if (selectedYear > currentYear - 4)
            {
                startYear = currentYear;
            }

            if (startYear > currentYear)
            {
                startYear = currentYear;
            }
        }

        <!-- Ссылка "Все" -->
        @{
            string allYearsQueryParams = "";

            // Сохраняем PlatformId если есть
            if (PlatformId.HasValue)
            {
                allYearsQueryParams += $"&PlatformId={PlatformId}";
            }

            // Сохраняем GenreId если есть
            if (GenreId.HasValue)
            {
                allYearsQueryParams += $"&GenreId={GenreId}";
            }

            // Убираем Year из параметров, чтобы показать все годы
            if (!string.IsNullOrEmpty(allYearsQueryParams))
            {
                allYearsQueryParams = "?" + allYearsQueryParams.TrimStart('&');
            }
        }
        <a href="/games/best-games/@allYearsQueryParams"
           class="@(showAllYears ? "selected" : "")">
            Все
        </a>

        @for (int i = 0; i < count; i++)
        {
            int yearToShow = startYear - i;

            // Строим URL
            string queryParams = $"?Year={yearToShow}";

            // Сохраняем PlatformId если есть
            if (PlatformId.HasValue)
            {
                queryParams += $"&PlatformId={PlatformId}";
            }

            // Сохраняем GenreId если есть
            if (GenreId.HasValue)
            {
                queryParams += $"&GenreId={GenreId}";
            }

            <a href="/games/best-games/@queryParams"
               class="@(yearToShow == selectedYear ? "selected" : "")">
                @yearToShow
            </a>
        }
    </div>
</div>