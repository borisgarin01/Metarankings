<!-- Фильтр по годам -->
<div class="filter-nav">
    <div class="filter-name">Год</div>
    <div class="filter-menu">
        @{
            int currentYear = DateTime.Today.Year;
            int count = 8;
            int selectedYear = Year; // Year уже int, не nullable

            int startYear;

            // Всегда показываем 4 года после и 3 до выбранного
            startYear = selectedYear + 3;

            // Если выбранный год близок к текущему, показываем от текущего вниз
            if (selectedYear > currentYear - 4)
            {
                startYear = currentYear;
            }

            // Если выбранный год слишком старый, корректируем
            if (startYear > currentYear)
            {
                startYear = currentYear;
            }
        }

        @for (int i = 0; i < count; i++)
        {
            int yearToShow = startYear - i;
            <a href="/games/best-games/?Year=@yearToShow"
               class="@(yearToShow == selectedYear ? "selected" : "")">
                @yearToShow
            </a>
        }
    </div>
</div>