@using System.Globalization
@using Domain.Games

<div class="item">
    <a href="/games/details/@Game.Id" title="Игра @Game.Name">
        <img class="post-image" src="@Game.Image" alt="@Game.Name">
    </a>
    <div class="small-score mark-@Math.Round(Game.UsersScore)">
        <span data-title="Рейтинг игры" class="tooltip">@Game.UsersScore.ToString("0.0", CultureInfo.GetCultureInfo("en-US"))</span>
    </div>
    <span class="item-name"><a href="/games/Details/@Game.Id">@Game.Name</a></span>
    <span class="item-meta">
        @for (int i = 0; i < Game.Platforms.Count - 1; i++)
        {
            <a href="/platforms/@Game.Platforms[i].Id">@Game.Platforms[i].Name</a>
            <text> / </text>
        }
        <a href="/platforms/@Game.Platforms[Game.Platforms.Count - 1].Id">@Game.Platforms[Game.Platforms.Count - 1].Name</a>
    </span>
    <span class="item-meta"><a rel="nofollow" href="/games/Details/@Game.Id/#reviews">Рецензии (@Game.CriticsReviewsCount)</a> <a rel="nofollow" href="/games/Details/@Game.Id/#comments">Отзывы (@Game.UsersReviewsCount)</a></span>
    <span class="item-meta">@Game.ReleaseDate.Value.ToString("dd MMMM yyyy")</span>
    <span class="item-description">@Game.Description</span>
</div>