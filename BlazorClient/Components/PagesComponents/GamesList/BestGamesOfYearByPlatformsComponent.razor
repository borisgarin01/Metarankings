@using Domain.Games

<!-- Фильтр по платформам -->
<div class="filter-nav">
    <div class="filter-name">Платформа</div>
    <div class="filter-menu">
        <a class="@(PlatformId is null ? "selected" : "")"
           href="@BuildUrl(null)">Все</a>

        @if (Platforms != null)
        {
            @foreach (Platform platform in Platforms)
            {
                <a class="@(PlatformId == platform.Id ? "selected" : "")"
                   href="@BuildUrl(platform.Id)">
                    @platform.Name
                </a>
            }
        }
    </div>
</div>