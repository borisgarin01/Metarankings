<!-- Фильтр по жанрам -->
<div class="filter-nav">
    <div class="filter-name">Жанр</div>
    <div class="filter-menu">
        <a class="@(GenreId is null ? "selected" : "")"
           href="@BuildUrl(null)">Все</a>

        @foreach (var genre in Genres)
        {
            <a class="@(GenreId == genre.Id ? "selected" : "")"
               href="@BuildUrl(genre.Id)">@genre.Name</a>
        }
    </div>
</div>