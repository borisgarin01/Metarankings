@if (IsVisible)
{
    <div class="popup_block" style="display: block;">
        <div class="close" @onclick="CloseAsync">
            <span>&times;</span>
        </div>

        <form id="loginForm" @onsubmit="PerformLoginAsync" @onsubmit:preventDefault="true">
            @if (!IsTwoFactorRequired)
            {
                <!-- Обычная форма входа -->
                <div class="field">
                    <label>Имя пользователя</label>
                    <div class="input">
                        <input type="email"
                               placeholder="Введите email"
                               @bind="LoginModel.UserEmail"
                               @bind:event="oninput" />
                    </div>
                </div>

                <div class="field">
                    <a rel="nofollow" id="forgot" href="/auth/resetPassword">Забыли?</a>
                    <label>Пароль</label>
                    <div class="input">
                        <input type="password"
                               placeholder="Введите пароль"
                               @bind="LoginModel.Password"
                               @bind:event="oninput" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(LoginError))
                {
                    <div style="color:#d32f2f; font-size:13px; margin:-10px 0 10px; padding:8px 12px; background:#ffebee; border-radius:4px;">
                        @LoginError
                    </div>
                }

                <div class="submit">
                    <button name="submit" type="submit" disabled="@IsLoading">
                        @if (IsLoading)
                        {
                            <span>Загрузка...</span>
                        }
                        else
                        {
                            <span>Войти</span>
                        }
                    </button>
                    <div class="registr">
                        <a rel="nofollow" href="/auth/register">Регистрация</a>
                    </div>
                </div>

                <!-- Соцсети -->
                @if (ExternalLogins != null && ExternalLogins.Any())
                {
                    <div style="margin-top:20px; padding-top:15px; border-top:1px solid #eee; text-align:center;">
                        <div style="color:#999; font-size:12px; margin-bottom:10px;">или</div>
                        <div style="display:flex; gap:8px; justify-content:center; flex-wrap:wrap;">
                            @foreach (var login in ExternalLogins)
                            {
                                var name = login.DisplayName ?? "";
                                var isVk = name.Contains("VK", StringComparison.OrdinalIgnoreCase)
                                            || name.Contains("ВКонтакте", StringComparison.OrdinalIgnoreCase);
                                var isYandex = name.Contains("Yandex", StringComparison.OrdinalIgnoreCase)
                                            || name.Contains("Яндекс", StringComparison.OrdinalIgnoreCase);

                                // VK ID: голубой круг + белая "VK"
                                var vkIcon = "data:image/svg+xml;utf8," +
                                    "<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'>" +
                                    "<rect width='24' height='24' rx='12' fill='%230077FF'/>" +
                                    "<path d='M12.7 16.2c-4.3 0-6.9-3-7-7.9h2.2c.1 3.6 1.7 5.1 2.9 5.4V8.3h2.1v3.1c1.2-.1 2.4-1.4 2.8-3.1h2.1c-.3 1.9-1.5 3.2-2.4 3.8 1 .4 2.3 1.6 2.8 3.6h-2.3c-.4-1.3-1.4-2.3-2.7-2.4v2.4h-.5z' fill='white'/>" +
                                    "</svg>";

                                // Yandex: красный круг + белая "Я"
                                var yaIcon = "data:image/svg+xml;utf8," +
                                    "<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'>" +
                                    "<rect width='24' height='24' rx='12' fill='%23FC3F1D'/>" +
                                    "<path d='M12.33 16.24c.70 1.54.93 2.07.93 3.91v2.45h-2.50v-4.12L6.03 8.20h2.61l3.68 8.04zm3.08-8.04l-3.06 6.96h2.55l3.07-6.96h-2.56z' fill='white'/>" +
                                    "</svg>";

                                var icon = isVk ? vkIcon : (isYandex ? yaIcon : null);
                                var iconStyle = icon != null
                                    ? $"background-image:url(\"{icon}\"); background-repeat:no-repeat; background-position:12px center; background-size:22px 22px; padding-left:42px;"
                                    : "padding-left:16px;";

                                <button type="button"
                                        @onclick="() => LoginExternal(login)"
                                        style="padding-top:8px; padding-right:16px; padding-bottom:8px;
                                    border:1px solid #ddd; border-radius:4px;
                                    background-color:#fff; cursor:pointer; font-size:13px;
                                    display:inline-flex; align-items:center;
                                    @iconStyle">
                                    @login.DisplayName
                                </button>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <!-- 2FA -->
                <div class="field">
                    <label>Код подтверждения</label>
                    <div class="input">
                        <input type="text"
                               placeholder="6-значный код"
                               maxlength="6"
                               @bind="TwoFactorCode"
                               @bind:event="oninput" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(TwoFactorError))
                {
                    <div style="color:#d32f2f; font-size:13px; margin:-10px 0 10px; padding:8px 12px; background:#ffebee; border-radius:4px;">
                        @TwoFactorError
                    </div>
                }

                <div class="submit" style="display:flex; gap:10px;">
                    <button type="button" @onclick="VerifyTwoFactorAsync" disabled="@IsLoading" style="flex:1;">
                        @if (IsLoading)
                        {
                            <span>Проверка...</span>
                        }
                        else
                        {
                            <span>Подтвердить</span>
                        }
                    </button>
                    <button type="button" @onclick="CancelTwoFactor" style="padding:6px 20px; border:1px solid #ccc; border-radius:4px; background:#fff; cursor:pointer;">
                        Назад
                    </button>
                </div>

                <div style="text-align:center; margin-top:12px;">
                    <a @onclick="ResendTwoFactorCode" style="cursor:pointer; color:#0082ae; text-decoration:none; font-size:13px;">
                        Отправить код повторно
                    </a>
                </div>
            }
        </form>
    </div>
}