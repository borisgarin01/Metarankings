@using Domain.Games
@using Domain.Movies
<div class="headerer">
    <div class="header-bottom">
        <div class="header clear nav-menu">
            <div class="menu-icon">
                <span></span>
                <span></span>
                <span></span>
                <span></span>
            </div>
            <div class="logo">
                <a href=""><span>Meta</span>Rankings</a>
            </div>
            <div class="nav">
                <ul>
                    <li>
                        <span><a href="/movies/movies-list/">Фильмы</a></span>
                        <ul class="dropdown-list">
                            <li><a href="/movies/new-movies/">Новинки</a></li>
                            <li><a href="/movies/coming-soon/">Скоро</a></li>
                            <li><a href="/movies/most-waiting-films/">Ожидаемые</a></li>
                            <li><a href="/movies/meta/movies/">Обзоры</a></li>
                            <li><a href="/movies/best-movies/">Топ фильмов</a></li>
                            <li><a href="/movies/best-movies/@DateTime.Today.Year">Фильмы @DateTime.Today.Year</a></li>
                            @foreach (MovieGenre genre in MoviesGenres)
                            {
                                <li>
                                    <a href="/movies/genres/@genre.Id">@genre.Name</a>
                                </li>
                            }
                        </ul>
                    </li>
                    <li class="active">
                        <span@* onclick="jQuery( document ).ready(function($){$('.game-drop').slideToggle('slow')});"*@>
                            <a href="/games/best-games?Year=@DateTime.Now.Year">Игры</a></span>
                            <div class="game-drop">
                                <a href="/games/new-games/">Новинки</a>
                                <a href="/games/release-date/">Дата выхода</a>
                                <a href="/games/most-waiting-games/">Ожидаемые</a>
                                <a href="/games/meta/games/">Обзоры</a>
                                <a href="/games/best-games?Year=@DateTime.Now.Year">Топ игр</a>
                                <a href="/games/best-games?Year=@(DateTime.Now.Year - 1)">Игры @(DateTime.Now.Year - 1)</a>
                                @foreach (Platform platform in Platforms)
                                {
                                    <a href="/games/best-games?PlatformId=@platform.Id">@platform.Name</a>
                                }
                                @foreach (Genre genre in GamesGenres)
                                {
                                    <a href="/games/best-games?GenreId=@genre.Id">Лучшие игры жанра @genre.Name</a>
                                }
                            </div>
                    </li>
                    <li>
                        <a href="/collections/">Подборки</a>
                    </li>
                    <li>
                        <a href="/user-reviews/">Отзывы</a>
                    </li>
                    <AuthorizeView>
                        <Authorized>
                            <li class="single-line">Привет, <a href="/auth/account/@context.User.FindFirstValue("UserId")">@context.User.FindFirstValue("UserName")</a></li>
                            <li class="single-line"><a href="/auth/logout">Выйти</a></li>
                        </Authorized>
                        <NotAuthorized>
                            <li class="single-line"><a href="/auth/login">Авторизируйся</a> или <a href="/auth/register">Зарегистрируйся</a></li>
                        </NotAuthorized>
                    </AuthorizeView>
                </ul>
            </div>
            <div class="nav_login">
                <ul>
                    <li><span class="user-login popauthor" title="Войти на сайт"></span></li>
                </ul>
            </div>
            <div class="search_form">
                <form method="get" id="searchform" action="/search/">
                    <fieldset>
                        <input name="text" type="search" id="search" placeholder="Название игры или фильма..." autocomplete="off">
                        <button type="submit">Искать</button>
                    </fieldset>
                </form>
                <div id="search_form-result"></div>
            </div>
        </div>
    </div>
</div>