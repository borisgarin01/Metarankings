@namespace BlazorClient.Components.PagesComponents.Common
@using BlazorClient.Components.PagesComponents.Home
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

<header>
    <div class="headerer">
        <div class="header-bottom @(isSticky ? "sticky" : "")" @ref="headerBottomRef">
            <div class="header clear nav-menu @(isMenuOpen ? "menu-open" : "")">
                <!-- Бургер-меню -->
                <div class="menu-icon" @onclick="ToggleMenu">
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                </div>

                <!-- Логотип -->
                <div class="logo">
                    <a href="/"><span>Meta</span>Rankings</a>
                </div>

                <!-- Навигация -->
                <div class="nav">
                    <ul class="nav-links">
                        <MoviesDropdownComponent Genres="@MoviesGenres" />
                        <GamesDropdownComponent Platforms="@Platforms" Genres="@GamesGenres" />

                        <li class="nav-link">
                            <a href="/collections/">Подборки</a>
                        </li>
                        <li class="nav-link">
                            <a href="/user-reviews/">Отзывы</a>
                        </li>

                        <!-- ===== ПРОФИЛЬ В ШТОРКЕ (ТОЛЬКО ДЛЯ АВТОРИЗОВАННЫХ) ===== -->
                        <AuthorizeView>
                            <Authorized>
                                <li class="nav-link nav-link-auth">
                                    <a href="/auth/account" title="@context.User.FindFirstValue("UserName")">
                                        @GetDisplayName(context.User.FindFirstValue("UserName"))
                                    </a>
                                </li>
                                <li class="nav-link nav-link-auth">
                                    <span class="user-logout" title="Выйти" @onclick="Logout"
                                          style="cursor: pointer;">
                                    </span>
                                </li>
                            </Authorized>
                        </AuthorizeView>
                    </ul>
                </div>

                <!-- ===== КНОПКА ВХОДА СВЕРХУ СПРАВА ===== -->
                <div class="nav_login">
                    <ul>
                        <AuthorizeView>
                            <NotAuthorized>
                                <li>
                                    <span class="user-login popauthor"
                                          title="Войти на сайт"
                                          @onclick="OpenLogin"
                                          style="cursor: pointer;">
                                    </span>
                                </li>
                            </NotAuthorized>
                        </AuthorizeView>
                    </ul>
                </div>

                <!-- Поиск -->
                <div class="search_form">
                    <form method="get" action="/search" @onsubmit="Search" @onsubmit:preventDefault="true">
                        <fieldset>
                            <input name="SearchText"
                                   type="search"
                                   id="search"
                                   placeholder="Название игры или фильма..."
                                   autocomplete="off"
                                   @bind="searchQuery"
                                   @bind:event="oninput"
                                   @onkeydown="OnKeyDown" />
                            <button type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </fieldset>
                    </form>
                    <div id="search_form-result"></div>
                </div>
            </div>
        </div>
    </div>
</header>

<!-- Модалка логина -->
<LoginModal @bind-IsVisible="isLoginOpen" OnLoginSuccess="OnLoginSuccessHandler" />

@code {
    private string GetDisplayName(string userName)
    {
        if (string.IsNullOrEmpty(userName)) return "Профиль";
        if (userName.Length > 12) return userName.Substring(0, 10) + "...";
        return userName;
    }
}