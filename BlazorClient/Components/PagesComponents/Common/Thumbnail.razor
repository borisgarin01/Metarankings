<div class="thumb">
    <img class="post-image" src="@ImageSource" alt="@Name" title="@Name" itemprop="image">

    <div class="best-prod">
        <span class="star">★</span> Лучшие в @ReleaseYear году
        <span class="inform">?</span>
    </div>

    @if (HasTrailer)
    {
        <div class="watch-trailer">
            <h3><span class="twatch" role="button" tabindex="0" @onclick="OpenTrailer" @onkeydown="OnTrailerKeyDown"><span class="p-twatch">@(Prefix == "Movies" ? "Трейлер" : "Смотреть трейлер")</span></span></h3>
        </div>
    }
</div>

@if (IsTrailerOpen)
{
    <div class="wbody" title="Закрыть" @onclick="CloseTrailer"></div>
    <div class="window" role="dialog" aria-modal="true" aria-label="Трейлер @Name">
        <div class="window-content">
            <div class="video-content">
                <div id="content-trailer">
                    <iframe title="Трейлер @Name"
                            src="@AutoplayTrailerUrl"
                            allow="clipboard-write; autoplay; encrypted-media; picture-in-picture"
                            allowfullscreen
                            style="border-width:0"></iframe>
                </div>
            </div>
        </div>
    </div>
}
