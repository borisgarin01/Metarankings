<div class="specials-index">
    <h3><a href="/meta/collections/">Подборки</a></h3>
    @if (CollectionsItemComponents is not null)
    {
        foreach (CollectionsItemComponent collectionsItemComponent in CollectionsItemComponents)
        {
            <CollectionsItemComponent Href="@collectionsItemComponent.Href" ImageAlt="@collectionsItemComponent.ImageAlt" ImageSource="@collectionsItemComponent.ImageSource" Title="@collectionsItemComponent.Title" />
        }
    }
</div>