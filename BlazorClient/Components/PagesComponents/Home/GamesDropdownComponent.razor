@using Domain.Games

<li class="nav-link services">
    <span><a href="/best-games/">Игры</a></span>
    <div class="drop-down">
        <a href="/new-games/">Новинки</a>
        <a href="/release-date/">Дата выхода</a>
        <a href="/most-waiting-games/">Ожидаемые</a>
        <a href="/best-games/">Топ игр</a>
        <a href="/games/best-games?Year=@DateTime.Now.Year">Игры @DateTime.Now.Year</a>
        @if (Platforms is not null && Genres is not null)
        {
            foreach (Platform platform in Platforms)
            {
                <a href="/games/best-games?platofrmId=@platform.Id">@platform.Name</a>
            }
            foreach (Genre genre in Genres)
            {
                <a href="/games/best-games?genreId=@genre.Id">@genre.Name</a>
            }
        }
    </div>
</li>