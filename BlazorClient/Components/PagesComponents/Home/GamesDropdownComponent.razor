@using BlazorClient.Components.PagesComponents.Common

<DropdownMenu Title="Игры"
              MainLink="@($"/games/best-games?Year={DateTime.Now.Year}")"
              DropdownClass="game-drop"
              IsActive="true">

    <!-- Основные ссылки -->
    <a href="/games/new-games/">Новинки</a>
    <a href="/games/release-date/">Дата выхода</a>
    <a href="/games/most-waiting-games/">Ожидаемые</a>
    <a href="/games/meta/games/">Обзоры</a>
    <a href="/games/best-games?Year=@DateTime.Now.Year">Топ игр</a>
    <a href="/games/best-games?Year=@(DateTime.Now.Year - 1)">Игры @(DateTime.Now.Year - 1)</a>

    <!-- Разделитель -->
    <div class="dropdown-divider"></div>

    <!-- Платформы -->
    @if (Platforms.Any())
    {
        <div class="dropdown-header">Платформы</div>
        @foreach (var platform in Platforms)
        {
            <a href="/games/best-games?PlatformId=@platform.Id">@platform.Name</a>
        }
    }

    <!-- Разделитель -->
    <div class="dropdown-divider"></div>

    <!-- Жанры -->
    @if (Genres.Any())
    {
        <div class="dropdown-header">Жанры</div>
        @foreach (var genre in Genres)
        {
            <a href="/games/best-games?GenreId=@genre.Id">@genre.Name</a>
        }
    }

    <!-- Годы (как в вашем примере) -->
    <div class="dropdown-divider"></div>
    <div class="dropdown-header">Годы</div>
    @foreach (var year in GetYears())
    {
        <a href="/games/best-games?Year=@year">Игры @year</a>
    }
</DropdownMenu>