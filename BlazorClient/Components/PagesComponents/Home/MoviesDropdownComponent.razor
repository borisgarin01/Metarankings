@using Domain.Movies

<li @onmouseenter="ShowMovies" @onmouseleave="HideMovies">
    <span><a href="/movies/best-movies/">Фильмы</a></span>
    <div class="movie-drop @(moviesDropdownClass)">
        <a href="/new-movies/">Новинки</a>
        <a href="/release-date/">Дата выхода</a>
        <a href="/most-waiting-moives/">Ожидаемые</a>
        <a href="/best-movies/">Топ фильмов</a>
        <a href="/movies/best-movies/?Year=@DateTime.Now.Year">Фильмы @DateTime.Now.Year</a>
        @if (Genres is not null)
        {
            foreach (Genre moviesGenre in Genres)
            {
                <a href="/movies/best-movies?genreId=@moviesGenre.Id">@moviesGenre.Name</a>
            }
        }
    </div>
</li>