@using Domain.Movies

<li class="nav-link services">
    <span><a href="/best-movies/">Фмльмы</a></span>
    <div class="drop-down">
        <a href="/new-movies/">Новинки</a>
        <a href="/release-date/">Дата выхода</a>
        <a href="/most-waiting-moives/">Ожидаемые</a>
        <a href="/best-movies/">Топ фильмов</a>
        <a href="/movies/best-movies?Year=@DateTime.Now.Year">Фильмы @DateTime.Now.Year</a>
        @if (Genres is not null)
        {
            foreach (MovieGenre moviesGenre in Genres)
            {
                <a href="/movies/movies-list?genreId=@moviesGenre.Id">@moviesGenre.Name</a>
            }
        }
    </div>
</li>